  "title": "Ordering food",
  "topic": "Grammar: want + direct object",
  "lesson_type": "grammar",
  "difficulty": 4,
  "level": "Early A1",
  "description": "Use ‘želim’ to ask for food and notice a common Croatian noun ending.",
  "grammar_note": "Želim means ‘I want’. When the wanted item is the direct object, many feminine nouns ending in -a change to -u: kava → kavu, voda → vodu, jabuka → jabuku. Common masculine inanimate nouns often keep the same form: kruh → kruh. ‘Molim’ makes an order polite.",
  "vocabulary": [
    {
      "hr": "Želim",
      "en": "I want"
    },
    {
      "hr": "Kavu",
      "en": "Coffee (as the thing wanted)"
    },
    {
      "hr": "Vodu",
      "en": "Water (as the thing wanted)"
    },
    {
      "hr": "Jabuku",
      "en": "Apple (as the thing wanted)"
    },
    {
      "hr": "Želim kavu",
      "en": "I want coffee"
    },
    {
      "hr": "Želim kruh",
      "en": "I want bread"
    }
  ],
  "exercises": [
