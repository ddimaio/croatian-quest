      "en": "Can you help me?"
    },
    {
      "hr": "Voglio viaggiare",
      "en": "I want to travel"
    },
    {
      "hr": "Vuoi…?",
      "en": "Do you want…?"
    },
    {
      "hr": "Quanto costa?",
      "en": "How much does it cost?"
    },
    {
