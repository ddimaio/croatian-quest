    "lesson-01-greetings": {
      "id": "lesson-01-greetings",
      "number": 1,
      "title": "Say hello",
      "topic": "Greetings",
      "lesson_type": "vocabulary",
      "difficulty": 1,
      "level": "Beginner",
      "description": "Greet people and use a few polite words.",
      "vocabulary": [
        {
          "hr": "Bok",
          "en": "Hi / bye"
        },
        {
          "hr": "Dobar dan",
          "en": "Good day"
        },
        {
          "hr": "Dobro jutro",
          "en": "Good morning"
        },
        {
          "hr": "Hvala",
          "en": "Thank you"
        },
        {
          "hr": "Molim",
          "en": "Please / you’re welcome"
        },
        {
          "hr": "Doviđenja",
          "en": "Goodbye"
        }
      ],
      "exercises": [
        {
          "type": "multiple_choice",
          "prompt": "How do you say ‘Hi’ in Croatian?",
          "options": [
            "Bok",
            "Hvala",
            "Molim",
            "Doviđenja"
          ],
          "answer": "Bok",
          "hint": "It can mean both hi and bye."
        },
        {
          "type": "translate_en_to_hr",
          "prompt": "Good morning",
          "answer": "Dobro jutro"
        },
        {
          "type": "translate_hr_to_en",
          "prompt": "Hvala",
          "answer": "Thank you"
        },
        {
          "type": "translate_en_to_hr",
          "prompt": "Good day",
          "answer": "Dobar dan"
        },
        {
          "type": "fill_blank",
          "prompt": "Complete: Do___đenja (goodbye)",
          "answer": "vi"
        },
        {
          "type": "fill_blank",
          "prompt": "Complete: Dobar ___ (good day)",
          "answer": "dan"
        },
        {
          "type": "reorder_words",
          "prompt": "Build the greeting: ‘Dobar dan, Ana.’",
          "words": [
            "dan,",
            "Ana.",
            "Dobar"
          ],
          "answer": [
            "Dobar",
            "dan,",
            "Ana."
          ]
        },
        {
          "type": "comprehension",
          "passage": "Ana: Dobar dan! Marko: Bok, Ana! Ana: Hvala!",
          "prompt": "Who says ‘Bok’?",
          "options": [
            "Ana",
            "Marko",
            "They both do"
          ],
          "answer": "Marko"
        }
      ]
    },
    "lesson-02-introductions": {
      "id": "lesson-02-introductions",
      "number": 2,
      "title": "Introduce yourself",
      "topic": "Names and pronouns",
      "lesson_type": "grammar",
      "difficulty": 1,
      "level": "Beginner",
      "description": "Learn a first sentence pattern and when Croatian drops pronouns.",
      "grammar_note": "Zovem se means ‘I am called’. Croatian often leaves out subject pronouns because the verb ending tells you who is speaking. Use Ja sam for emphasis: ‘I am…’.",
      "vocabulary": [
        {
          "hr": "Zovem se",
          "en": "My name is / I am called"
        },
        {
          "hr": "Ja sam",
          "en": "I am"
        },
        {
          "hr": "Kako se zoveš?",
          "en": "What is your name?"
        },
        {
          "hr": "Drago mi je",
          "en": "Nice to meet you"
        }
      ],
      "exercises": [
        {
          "type": "translate_en_to_hr",
          "prompt": "My name is Ana",
          "answer": "Zovem se Ana"
        },
        {
          "type": "translate_hr_to_en",
          "prompt": "Kako se zoveš?",
          "answer": "What is your name?"
        },
        {
          "type": "multiple_choice",
          "prompt": "What does ‘Drago mi je’ mean?",
          "options": [
            "Nice to meet you",
            "Good morning",
            "Where are you?"
          ],
          "answer": "Nice to meet you"
        },
        {
          "type": "translate_en_to_hr",
          "prompt": "I am Marko",
          "answer": "Ja sam Marko",
          "hint": "Use Ja sam to emphasize ‘I am’."
        },
        {
          "type": "reorder_words",
          "prompt": "Put the words in order: ‘My name is Ana.’",
          "words": [
            "Ana.",
            "se",
            "Zovem"
          ],
          "answer": [
            "Zovem",
            "se",
            "Ana."
          ]
        },
        {
          "type": "comprehension",
          "passage": "Zovem se Luka. Drago mi je.",
          "prompt": "What is his name?",
          "options": [
            "Luka",
            "Ana",
            "Marko"
          ],
          "answer": "Luka"
        },
        {
          "type": "translate_hr_to_en",
          "prompt": "Drago mi je",
          "answer": "Nice to meet you"
        },
        {
          "type": "fill_blank",
          "prompt": "Complete the question: Kako se ___? (What is your name?)",
          "answer": "zoveš"
        }
      ]
    },
