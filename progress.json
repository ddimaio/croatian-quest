            "Good evening"
          ],
          "answer": "The bill, please"
        },
        {
          "type": "translate_en_to_hr",
          "prompt": "Tea",
          "answer": "Čaj"
        },
        {
          "type": "translate_hr_to_en",
          "prompt": "Sok",
          "answer": "Juice"
        },
        {
          "type": "reorder_words",
          "prompt": "Put the order together: ‘One coffee, please.’",
          "words": [
            "molim.",
            "kavu,",
            "Jednu"
          ],
          "answer": [
            "Jednu",
            "kavu,",
            "molim."
          ]
        },
        {
          "type": "comprehension",
          "passage": "Ana: Jednu kavu, molim. Konobar: Izvolite.",
          "prompt": "What does Ana order?",
          "options": [
            "Coffee",
            "Tea",
            "Water"
          ],
          "answer": "Coffee"
        },
        {
          "type": "fill_blank",
          "prompt": "Complete the order: Čaj, ___. (Tea, please.)",
          "answer": "molim"
        }
      ]
    },
